@import "colors.rasi"

* {
    font: "Roboto 11";
    background-color: transparent;
    text-color: @on-surface;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: east;
    anchor: east;
    x-offset: -12px;
    height: 85%;
    width: 400px;
    border-radius: 28px;
    background-color: @surface;
    border: 1px;
    border-color: @surface-variant;
}

mainbox {
    padding: 24px;
    children: [ textbox-header, listview ];
}

textbox-header {
    expand: false;
    content: "󰂚  Notifications";
    font: "Roboto Medium 15";
    margin: 0 0 20px 0;
    text-color: @primary;
}

listview {
    enabled: true;
    columns: 1;
    cycle: true;
    dynamic: true;
    layout: vertical;
    spacing: 12px;
    fixed-height: false;
    scrollbar: true;
}

scrollbar {
    handle-width: 4px;
    handle-color: @primary;
    border-radius: 10px;
    background-color: @surface-variant;
    margin: 0px;
}

element {
    padding: 0px;
    border-radius: 24px;
    background-color: @surface-variant;
    cursor: pointer;
}

element-text {
    padding: 16px 0px;
    cursor: inherit;
    text-color: inherit;
    vertical-align: 1;
    line-spacing: 4px;
}

element selected.normal {
    border: 2px;
    border-color: @primary;
}

textbox {
    text-color: @on-surface-variant;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
