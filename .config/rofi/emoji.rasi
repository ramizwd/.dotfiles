@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @on-surface;
    font: "Roboto 12";
}

window {
    width: 500px;
    height: 400px;
    border: 1px;
    border-color: @surface-variant;
    border-radius: 28px;
    background-color: @surface;
}

mainbox {
    padding: 24px;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface-variant;
    border-radius: 28px;
    padding: 12px 16px;
    children: [ entry ];
}

entry {
    placeholder: "Search emojis...";
    placeholder-color: @on-surface-variant;
    text-color: @on-surface;
}

listview {
    columns: 6;
    lines: 6;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    layout: vertical;
}

element {
    orientation: vertical;
    padding: 10px 0px 40px 0px;
    border-radius: 16px;
    cursor: pointer;
}

element-text {
    font: "Noto Color Emoji 24, Roboto 24";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
    text-color: inherit;
}

element-icon {
    enabled: false;
}

element selected.normal {
    background-color: @selected-container;
    text-color: @on-selected-container;
}
